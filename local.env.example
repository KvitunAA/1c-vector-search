# Пример настроек для текущей машины (скопируйте в local.env)
# local.env создаётся автоматически при запуске setup_machine.py

# Путь к интерпретатору Python (если python не в PATH)
# После scripts\bootstrap_python.ps1 будет, например:
# VECTOR_PYTHON_PATH=C:\Cursor\ProectVectorSearch\.tools\python312\python.exe
VECTOR_PYTHON_PATH=C:\path\to\python.exe
